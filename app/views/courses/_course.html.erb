<div id="<%= dom_id course %>">
  <div>
    <strong>Title:</strong>
    <%= course.title %>
  </div>

  <div>
    <strong>Description:</strong>
    <%= course.description %>
  </div>

  <div>
    <strong>Instructor:</strong>
    <%= course.user&.email || "Unknown" %>
  </div>

  <% if course.owned_by?(current_user) %>
    <div>
      <strong>Join Code:</strong>
      <code><%= course.join_code %></code>
    </div>
  <% end %>
</div>
