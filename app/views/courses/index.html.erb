<% content_for :title, "Courses" %>

<h1>Courses</h1>

<div id="courses">
  <% @courses.each do |course| %>
    <%= render course %>
    <p>
      <%= link_to "Show this course", course %>
    </p>
  <% end %>
</div>

<% if current_user.can_manage_courses? %>
  <%= link_to "New course", new_course_path %>
<% end %>
